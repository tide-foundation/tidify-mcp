{
  "name": "tidify-bridge",
  "version": "0.1.0",
  "description": "tidify-bridge MCP server (stdio).",
  "private": true,
  "type": "module",
  "bin": {
    "tidify-bridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:page": "esbuild page/login.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=page/dist/login.js",
    "typecheck": "tsc",
    "pretest": "npm run build:page",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx -y @modelcontextprotocol/inspector@latest --web -e TIDECLOAK_URL=http://localhost:8080 -e TIDECLOAK_REALM=a --protocol-era modern node src/index.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@tidecloak/js": "^0.14.41",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
